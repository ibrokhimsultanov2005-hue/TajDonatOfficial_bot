API_TOKEN = '8617960858:AAFSEvPkFuAvCs8uxXMyXoF0Ou7uOe63-2o'

# ==========================================
# 2. СЮДА ВСТАВЬ СВОЙ TELEGRAM ID
# (только цифры, без кавычек)
